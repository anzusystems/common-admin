{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/vite-env.d.ts",
    "src/**/*",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/__tests__/*",
    "src/test/**/*",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "dist"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "noUncheckedIndexedAccess": false
  }
}
