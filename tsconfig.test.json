{
  "extends": "./tsconfig.app.json",
  "include": [
    "src/vite-env.d.ts",
    "src/test/**/*",
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.test.tsbuildinfo",
    "types": ["vitest/globals", "node"],
    "allowImportingTsExtensions": false,
    "noEmit": true,
    // More lenient settings for tests
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    // The library code is checked with it (#119); in tests an index into what they just built would only
    // gain a `!` (420 of them), the test failing the same way without it.
    "noUncheckedIndexedAccess": false
  }
}
