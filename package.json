{
  "name": "@anzusystems/common-admin",
  "packageManager": "yarn@4.18.1",
  "files": [
    "dist",
    "src/eslint/**",
    "src/vite/**"
  ],
  "module": "./dist/common-admin.js",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/common-admin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/common-admin.d.ts",
      "import": "./dist/common-admin.js"
    },
    "./styles": {
      "types": "./dist/common-admin.css.d.ts",
      "default": "./dist/common-admin.css"
    },
    "./eslint": {
      "types": "./src/eslint/plugin.d.mts",
      "default": "./src/eslint/plugin.mjs"
    },
    "./oxlint": "./src/eslint/oxlint.mjs",
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./vite": {
      "types": "./src/vite/index.d.mts",
      "default": "./src/vite/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "version": "2.0.0-rc.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anzusystems/common-admin.git"
  },
  "scripts": {
    "prepare": "node -e \"if (process.env.SKIP_PLAYWRIGHT_INSTALL !== 'true') { require('child_process').execSync('playwright install chromium --with-deps', { stdio: 'inherit' }) }\"",
    "playground:dev": "vite",
    "playground:build": "vite build",
    "playground:build:nm": "vite build --minify false",
    "build": "vite build --config vite.config.lib.mts",
    "dev:admin": "COMMON_ADMIN_DTS=0 COMMON_ADMIN_DEV_BUNDLE=1 vite build --watch --config vite.config.lib.mts --outDir node_modules/.cache/common-admin-dev --emptyOutDir --logLevel warn",
    "dev:admin:types": "COMMON_ADMIN_COPY=types vite build --config vite.config.lib.mts --logLevel warn",
    "build:dev": "vite build --minify false --sourcemap true --config vite.config.lib.mts",
    "lib:build": "run-s --print-name lint:tsc build",
    "ci": "run-p --aggregate-output --continue-on-error --print-label --silent lint:tsc format:check lint:oxlint lint:eslint lint:stylelint",
    "lint": "[ \"$*\" = \"--fix\" ] && yarn lint:fix || yarn ci",
    "lint:fix": "run-s --print-name lint:tsc lint:oxlint:fix lint:eslint:fix lint:stylelint:fix format",
    "lint:tsc": "NODE_OPTIONS=--max-old-space-size=4096 vue-tsc --build",
    "lint:tsc:test": "NODE_OPTIONS=--max-old-space-size=4096 vue-tsc --build tsconfig.test.json",
    "lint:eslint": "eslint",
    "lint:eslint:fix": "eslint --fix",
    "lint:oxlint": "oxlint . --disable-nested-config",
    "lint:oxlint:fix": "oxlint . --fix --disable-nested-config",
    "lint:stylelint": "stylelint src/**/*.{scss,vue}",
    "lint:stylelint:fix": "stylelint src/**/*.{scss,vue} --fix",
    "format": "oxfmt --disable-nested-config src vite.config.lib.mts vite.config.mts vitest.config.mts eslint.config.mjs",
    "format:check": "oxfmt --disable-nested-config src vite.config.lib.mts vite.config.mts vitest.config.mts eslint.config.mjs --check",
    "test": "vitest",
    "test:browser": "vitest run",
    "test:eslint": "vitest run --config vitest.config.node.mts",
    "test:run": "run-s --print-name test:browser test:eslint",
    "test:ui": "vitest --ui",
    "release:start": "npx -y --allow-git=all github:anzusystems/release-tools#main start",
    "release:publish": "npx -y --allow-git=all github:anzusystems/release-tools#main publish",
    "release:cleanup": "npx -y --allow-git=all github:anzusystems/release-tools#main cleanup"
  },
  "devDependencies": {
    "@anzusystems/common-admin": "workspace:*",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@mdi/font": "^7.4.47",
    "@sentry/vite-plugin": "11.9.0",
    "@sentry/vue": "^11.9.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^24.19.2",
    "@types/rusha": "^0.8.3",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/compiler-dom": "3.5.44",
    "@vue/devtools-api": "^8.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/language-server": "3.3.13",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "0.9.1",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vueuse/core": "15.0.0",
    "@vueuse/integrations": "15.0.0",
    "@vueuse/shared": "15.0.0",
    "axios": "1.20.0",
    "cropperjs": "2.3.1",
    "dayjs": "1.11.23",
    "eslint": "^10.13.0",
    "eslint-plugin-oxlint": "1.89.0",
    "eslint-plugin-pinia": "^0.4.2",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vuetify": "^2.7.3",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "pinia": "4.1.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "postcss-html": "^2.0.0",
    "rusha": "^0.8.14",
    "sass": "1.106.1",
    "socket.io-client": "4.8.4",
    "sortablejs": "^1.15.7",
    "stylelint": "17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "unplugin": "3.4.0",
    "unplugin-dts": "^1.1.2",
    "uuid": "^14.0.3",
    "vite": "8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue": "3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.13",
    "vuetify": "4.3.0"
  },
  "peerDependencies": {
    "@mdi/font": "^7.4.47",
    "@sentry/vite-plugin": "^11.9.0",
    "@sentry/vue": "^11.9.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/shared": "^15.0.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "eslint": "^10.13.0",
    "eslint-plugin-oxlint": "^1.89.0",
    "eslint-plugin-pinia": "^0.4.2",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuetify": "^2.7.3",
    "oxlint": "^1.89.0",
    "pinia": "^4.1.0",
    "socket.io-client": "^4.8.4",
    "sortablejs": "^1.15.7",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@sentry/vite-plugin": {
      "optional": true
    },
    "@vue/eslint-config-typescript": {
      "optional": true
    },
    "@vueuse/shared": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-oxlint": {
      "optional": true
    },
    "eslint-plugin-pinia": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "eslint-plugin-vuetify": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
